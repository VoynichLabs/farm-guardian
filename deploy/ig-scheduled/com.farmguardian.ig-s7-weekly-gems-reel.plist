<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.farmguardian.ig-s7-weekly-gems-reel</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/macmini/GitHub/farm-guardian/venv/bin/python</string>
        <string>/Users/macmini/GitHub/farm-guardian/scripts/ig-s7-weekly-gems-reel.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/macmini/GitHub/farm-guardian</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/ig-s7-weekly-gems-reel.out.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/ig-s7-weekly-gems-reel.err.log</string>

    <!-- Sundays 10:30 local. Was the s7-backlog drain at 09/13/17/20 daily;
         that backlog is finished, so this is a weekly highlights reel now.
         10:30 avoids stacking against 09:00 house-yard, 12:30 carousel,
         18:00 mixed, 18:30 Nextdoor, Sun 20:00 digest and 21:00 s7 daily. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key>
            <integer>0</integer>
            <key>Hour</key>
            <integer>10</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>ThrottleInterval</key>
    <integer>60</integer>
</dict>
</plist>
