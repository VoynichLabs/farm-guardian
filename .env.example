# Farm Guardian — Environment Secrets
# Copy this to .env and fill in your real values.

# Camera credentials
CAMERA_PASSWORD=your_camera_password

# Discord webhook for farm reports and alerts: the Autoresearch Arena #farm channel (moved 20-Nov-2026).
# DISCORD_ARENA_WEBHOOK_URL holds the same Arena #farm webhook (S7 gem posts read it first).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_ARENA_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
# VoynichLabs-server webhook, only for the music-video Instagram notices (tools/voynichlabs/ig_reel_poster.py).
DISCORD_VOYNICH_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# eBird API key (get from https://ebird.org/api/keygen)
EBIRD_API_KEY=your_ebird_api_key

# Cloudflare API token (cfat_ prefix — for managing tunnels via API)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Cloudflare Tunnel run token (base64 string — used by cloudflared to connect)
# Get this from: cloudflared tunnel token <tunnel-name>
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token
